# Public site URL used for canonical links and sitemap generation
SITE_URL=http://localhost:3000

# Content mode: "mock" | "airtable"
CONTENT_SOURCE=mock

# Airtable (server-only — never use NEXT_PUBLIC_*)
# Create a PAT with data.records:read + schema.bases:read for this base.
# For /admin writes, also grant data.records:write.
# Schema instructions: AIRTABLE-SCHEMA.md
AIRTABLE_PAT=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_PROJECTS=Projects
AIRTABLE_TABLE_PROJECT_IMAGES=Project Images
AIRTABLE_TABLE_SERVICES=Services
AIRTABLE_TABLE_BLOG_POSTS=Blog Posts
AIRTABLE_TABLE_PRICES=Prices
AIRTABLE_TABLE_SITE_SETTINGS=Site Settings
AIRTABLE_REVALIDATE_SECONDS=600
AIRTABLE_FALLBACK_TO_MOCK=true

# Email (Resend)
# Create an API key at https://resend.com
# CONTACT_FROM_EMAIL must be a verified sender (domain or onboarding address).
RESEND_API_KEY=
CONTACT_TO_EMAIL=e.kadiyski@gmail.com
CONTACT_FROM_EMAIL=

# Admin dashboard (Auth.js Credentials — server-only)
# Generate AUTH_SECRET with: openssl rand -base64 32
# Generate credentials with: npm run admin:hash-password
# Prefer ADMIN_EMAIL + ADMIN_PASSWORD_HASH (bcrypt64:...) — avoids dotenv corrupting $ in bcrypt hashes.
AUTH_SECRET=
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=bcrypt64:...
# Legacy alternative (optional if ADMIN_EMAIL pair is set):
# ADMIN_USERS='[{"email":"admin@example.com","passwordHash":"bcrypt64:..."}]'

# Analytics (production only; consent deferred — do not enable until consent is ready)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=
